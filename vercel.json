{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/assets/(.*)",
      "destination": "/tenspickbackend-main/frontend/assets/$1"
    },
    {
      "source": "/pages/(.*)",
      "destination": "/tenspickbackend-main/frontend/pages/$1"
    },
    {
      "source": "/client/(.*)",
      "destination": "/tenspickbackend-main/frontend/client/$1"
    },
    {
      "source": "/staff/(.*)",
      "destination": "/tenspickbackend-main/frontend/staff/$1"
    },
    {
      "source": "/env.js",
      "destination": "/tenspickbackend-main/frontend/env.js"
    },
    {
      "source": "/(.*)",
      "destination": "/tenspickbackend-main/frontend/$1"
    }
  ]
}
